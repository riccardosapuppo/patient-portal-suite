@page
@model IndexModel
@{
    ViewData["Title"] = "Your documents";
}

<h1>Your documents</h1>

@if (Model.Documents.Count == 0)
{
    <p class="lead">
        There is nothing here yet. When a clinician releases a report it will
        appear on this page.
    </p>
}
else
{
    <p class="lead">
        @Model.Documents.Count document@(Model.Documents.Count == 1 ? "" : "s"),
        which are the documents recorded against your name and no others.
    </p>

    <ul class="documents">
        @foreach (var one in Model.Documents)
        {
            @*
                The state is on the row itself, as the edge down its left side.
                Going down a list the question is which of these can I read, and
                a colour answers it before the words do -- but never on its own:
                every row also says the state in words, because a colour is not
                a sentence and not everybody sees the difference between two of
                them.
            *@
            <li class="@(one.Released ? (one.Sensitive ? "guarded" : "") : "waiting")">
                <span>
                    <span class="what">@one.Title</span><br />
                    <span class="id">@one.Id</span>
                </span>

                @if (!one.Released)
                {
                    <span class="state">Not released until a clinician signs it off.</span>
                }
                else if (one.Sensitive)
                {
                    <a class="open guarded" href="/Code?id=@one.Id">Send me a code</a>
                }
                else
                {
                    @*
                        A real link to the real document, opening in its own tab
                        on its own. viewer.js intercepts the press and shows the
                        same URL in the dialog below, so the list stays where it
                        is; with the script turned off the report still opens,
                        beside the list rather than over it.
                    *@
                    <a class="open" href="/Open?id=@one.Id" target="_blank" rel="noopener"
                       data-open="@one.Id" data-what="@one.Title">Open</a>
                }
            </li>
        }
    </ul>

    @*
        The report, on top of the list rather than instead of it.

        Empty until something is opened: the frame is given an address on the
        way in and has it taken away again on the way out, so a report is never
        left loaded behind a closed dialog.
    *@
    <dialog class="viewer">
        <div class="viewer-bar">
            <span class="viewer-said">
                <span class="viewer-what"></span>
                <span class="viewer-id"></span>
            </span>

            <a class="viewer-tab" target="_blank" rel="noopener">Open in a new tab</a>
            <button type="button" class="viewer-shut">Close</button>
        </div>

        <iframe class="viewer-page" title="The report"></iframe>
    </dialog>

    <script src="~/viewer.js" defer></script>
}
