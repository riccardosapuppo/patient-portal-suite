@*
    The frame round every page.

    The banner is not decoration. Everything in this portal is invented, and a
    screenshot of it will end up somewhere without the README attached, so the
    page says so itself.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Patient portal</title>
    <link rel="stylesheet" href="~/portal.css" />
</head>
<body>
    <p class="invented">Every patient and every document in this portal is invented.</p>

    <header>
        <div class="bar">
            <a class="mark" href="/">Patient portal</a>
            @if (Who.SignedIn(User) is { } patient)
            {
                @*
                    asp-page rather than a written-out action, and that is the
                    whole of a bug somebody hit on their first afternoon here.

                    The tag helper puts the antiforgery token into a form it
                    addresses itself. Give the form an action attribute of your
                    own and it steps back and adds nothing -- so this posted
                    without a token and every sign out answered 400. The page
                    looked right, the handler was right, and the button was the
                    only one in the portal no check had ever pressed.
                *@
                <form method="post" asp-page="/SignIn" asp-page-handler="Out">
                    <span class="as">signed in as <strong>@patient</strong></span>
                    <button type="submit">Sign out</button>
                </form>
            }
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>
            A demonstration. It reconstructs a production system I designed and
            developed; the original cannot be published, so this one was written
            from scratch. Its archive has no method that takes a document
            identifier on its own, so no page can ask for a document without
            saying who is asking.
        </p>

        <p class="by">
            Developed by
            <a href="https://github.com/riccardosapuppo" target="_blank" rel="noopener noreferrer">Riccardo Sapuppo</a>
        </p>
    </footer>
</body>
</html>
